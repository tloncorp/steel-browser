// Explicit, versioned interface for the Tlon native viewer. Only status leaves
// this page; keystrokes and pasted text go straight to the session socket.
const mobileInput = (() => {
    if (!interactive || !window.ReactNativeWebView?.postMessage) return null;
    // Native supplies floating controls; Agent View uses the full viewport.
    const chrome = document.createElement('style');
    chrome.textContent = `
        header { display: none !important; background: Canvas; }
        body[data-native-browser-controls="true"] header { display: flex !important; }
        header #keyboard, header .viewport-control { display: none !important; }
        body, #stage { background: #0b0b0b; }
    `;
    const header = document.querySelector('header');
    let browserControlsVisible = false;
    document.head.appendChild(chrome);
    // Zoom the canvas, never the surrounding document or hidden keyboard input.
    document.querySelector('meta[name="viewport"]').content =
        'width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover';
    const input = document.createElement('textarea');
    input.id = 'mobile-session-keyboard';
    input.setAttribute('aria-label', 'Type into the remote browser');
    input.setAttribute('autocapitalize', 'off');
    input.setAttribute('autocorrect', 'off');
    input.setAttribute('autocomplete', 'off');
    input.spellcheck = false;
    // Keep a focusable input in the viewport without covering the remote page.
    // A sentinel lets the soft keyboard deliver Backspace even after each flush.
    input.style.cssText = 'position:fixed;top:1px;left:1px;width:1px;height:1px;opacity:0.01;font-size:16px;padding:0;border:0;pointer-events:none;';
    document.body.appendChild(input);
    const sentinel = '\u200b';
    let composing = false;
    let discardNextInput = false;
    let context = 0;
    let targetId, targetConnection, availableBefore, targetGeneration, targetViewport;
    let requestedReload = null;
    let previousStatus;
    let insets = {top: 0, bottom: 0, keyboardBottom: 0};
    let appliedInsets = 0;
    function reservedSpace(nextMode = mode) {
        return nextMode === 'mobile' ? (browserControlsVisible ? 0 : insets.top) +
            (document.activeElement === input ? insets.keyboardBottom : insets.bottom) : 0;
    }
    function applyInsets() {
        const mobile = mode === 'mobile';
        // The header occupies layout space; do not reserve the native control
        // row a second time above the streamed page when the bar is visible.
        header.style.marginTop = (browserControlsVisible ? insets.top : 0) + 'px';
        const top = mobile && !browserControlsVisible ? insets.top : 0;
        stage.style.marginTop = top + 'px';
        stage.style.marginBottom = (mobile ? reservedSpace() - top : 0) + 'px';
        appliedInsets = reservedSpace();
    }
    function viewportHeight(nextMode) {
        return stage.clientHeight + appliedInsets - reservedSpace(nextMode);
    }

    function reset() {
        input.value = sentinel;
        input.setSelectionRange(1, 1);
    }
    function available() { return ready && controlling && socket?.readyState === WebSocket.OPEN; }
    function update(force = false) {
        applyInsets();
        const isReady = available();
        if (targetId !== pageId || targetConnection !== connection || targetGeneration !== generation) requestedReload = null;
        if (targetId !== pageId || targetConnection !== connection || availableBefore !== isReady || targetGeneration !== generation || targetViewport !== viewportGeneration) {
            targetId = pageId; targetConnection = connection; availableBefore = isReady;
            targetGeneration = generation; targetViewport = viewportGeneration;
            context++;
            composing = false;
            reset();
            input.blur();
        }
        const status = JSON.stringify({type: 'tlon.browser.input', version: 1,
            ready: isReady, keyboardOpen: document.activeElement === input, context, browserControlsVisible,
            mode: mode === "mobile" ? "mobile" : "agent", reloadRequired: requestedReload});
        if (force || status !== previousStatus) {
            previousStatus = status;
            window.ReactNativeWebView.postMessage(status);
        }
    }
    function send(message) { if (available()) action(message); }
    function key(key, code, keyCode) {
        send({type: 'keyEvent', event: {type: 'keyDown', key, code, keyCode,
            modifiers: 0}});
        send({type: 'keyEvent', event: {type: 'keyUp', key, code, keyCode, modifiers: 0}});
    }
    function flush() {
        const text = input.value.startsWith(sentinel) ? input.value.slice(1) : input.value;
        if (text) send({type: 'insertText', text});
        reset();
    }
    function finishComposition() {
        if (!composing) return;
        // Let the IME commit to the old remote field before a tap or paste.
        // Re-focus immediately so changing remote fields keeps the keyboard up.
        input.blur();
        input.focus({preventScroll: true});
    }
    input.addEventListener('compositionstart', () => { composing = true; });
    input.addEventListener('compositionend', () => { composing = false; flush(); });
    input.addEventListener('input', (event) => {
        if (discardNextInput) { discardNextInput = false; reset(); return; }
        if (!composing && !event.isComposing) flush();
    });
    input.addEventListener('beforeinput', (event) => {
        if (composing || event.isComposing) return;
        const keys = {deleteContentBackward: ['Backspace', 'Backspace', 8],
            deleteContentForward: ['Delete', 'Delete', 46],
            insertLineBreak: ['Enter', 'Enter', 13], insertParagraph: ['Enter', 'Enter', 13]};
        const value = keys[event.inputType];
        if (value) {
            // Some soft keyboards emit non-cancelable edits. Do not forward
            // their local newline again after dispatching the remote key.
            discardNextInput = !event.cancelable;
            event.preventDefault();
            key(...value);
            reset();
        }
    });
    input.addEventListener('keydown', (event) => {
        if (composing || event.isComposing) return;
        if (['Enter', 'Tab', 'ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'Escape'].includes(event.key)) {
            event.preventDefault();
            key(event.key, event.code, event.keyCode);
        }
    });
    input.addEventListener('focus', () => update());
    input.addEventListener('blur', () => { composing = false; reset(); update(); });
    window.addEventListener('pagehide', () => { input.blur(); reset(); });
    window.tlonBrowserInput = Object.freeze({
        receive(command) {
            if (command?.version !== 1) return;
            update();
            if (command.type === 'insets') {
                const keys = ['top', 'bottom', 'keyboardBottom'];
                if (!keys.every(key => Number.isFinite(command[key]) && command[key] >= 0 && command[key] <= 300)) return;
                if (keys.every(key => command[key] === insets[key])) return;
                insets = Object.fromEntries(keys.map(key => [key, command[key]]));
                applyInsets();
                if (controlling && mode === 'mobile' && document.activeElement !== input) requestViewport();
                return;
            }
            if (command.type === 'browserControls') {
                if (typeof command.visible !== 'boolean' || command.visible === browserControlsVisible) return;
                browserControlsVisible = command.visible;
                if (!browserControlsVisible) {
                    closeMenu();
                    if (header.contains(document.activeElement)) document.activeElement.blur();
                }
                document.body.dataset.nativeBrowserControls = String(browserControlsVisible);
                update(true);
                // Agent View never resizes the remote browser. Mobile View
                // fits the space remaining below the newly visible toolbar.
                if (controlling && mode === 'mobile') requestViewport();
                return;
            }
            if (command.type === 'status') { update(true); return; }
            if (command.type === 'keyboard' && command.open === false) { input.blur(); return; }
            if (command.type === 'layout' && controlling && command.context === context && ['agent', 'mobile'].includes(command.mode)) {
                requestedReload = null;
                requestViewport(command.mode, command.reload === true);
                update(true);
                return;
            }
            if (!available() || command.context !== context) return;
            if (command.type === 'keyboard' && command.open === true) {
                reset();
                input.focus({preventScroll: true});
            } else if (command.type === 'paste' && typeof command.text === 'string' && command.text.length <= 65536) {
                // Finish any pending composition before inserting the clipboard.
                finishComposition();
                if (command.text) send({type: 'insertText', text: command.text});
            }
        }
    });
    reset();
    update();
    return {update, finishComposition, viewportHeight,
        keyboardOpen: () => document.activeElement === input,
        invalidate() { context++; composing = false; reset(); input.blur(); update(); },
        reloadRequired(mode) { requestedReload = mode; update(true); }
    };
})();
