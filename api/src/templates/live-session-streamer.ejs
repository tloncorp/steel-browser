<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="referrer" content="no-referrer" />
    <title>Live browser</title>
    <style>
      :root {
        color-scheme: <%= theme === 'dark' ? 'dark' : 'light' %>;
        font:
          14px system-ui,
          sans-serif;
        background: Canvas;
        color: CanvasText;
      }
      [hidden] {
        display: none !important;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        height: 100dvh;
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }
      header {
        flex: none;
        display: flex;
        position: relative;
        z-index: 2;
        align-items: center;
        gap: 4px;
        padding: 6px;
        border-bottom: 1px solid #8885;
      }
      button,
      select,
      input,
      textarea {
        font: inherit;
      }
      button,
      select {
        min-height: 36px;
        border: 1px solid #8887;
        border-radius: 8px;
        padding: 6px 10px;
        background: Canvas;
        color: CanvasText;
      }
      button:disabled,
      select:disabled {
        opacity: 0.5;
      }
      #control {
        background: #245de8;
        color: white;
        border-color: #245de8;
      }
      #url {
        flex: 1;
        min-width: 0;
        width: 0;
        height: 36px;
        font-size: 16px;
        border: 1px solid #8885;
        border-radius: 8px;
        padding: 9px;
        background: Canvas;
        color: CanvasText;
      }
      .icon-button,
      .viewport-control {
        flex: none;
        width: 32px;
        height: 36px;
        display: grid;
        place-items: center;
        padding: 0;
        border: 0;
        border-radius: 6px;
        background: transparent;
        color: CanvasText;
        font-size: 20px;
      }
      .icon-button:hover,
      .viewport-control:hover {
        background: #8882;
      }
      .viewport-control {
        position: relative;
      }
      .viewport-control svg {
        width: 20px;
        height: 20px;
        fill: currentColor;
      }
      .viewport-control select {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        cursor: pointer;
        font-size: 16px;
      }
      .viewport-control:focus-within {
        outline: 2px solid #245de8;
      }
      .viewport-control:has(select:disabled) {
        opacity: 0.5;
      }
      #browser-menu {
        position: absolute;
        top: calc(100% + 4px);
        right: 6px;
        width: min(280px, calc(100vw - 12px));
        display: grid;
        gap: 8px;
        padding: 12px;
        border: 1px solid #8885;
        border-radius: 10px;
        background: Canvas;
        box-shadow: 0 4px 20px #0002;
      }
      #tabs {
        min-width: 0;
        width: 100%;
      }
      #status {
        position: absolute;
        top: calc(100% + 4px);
        left: 6px;
        max-width: calc(100vw - 12px);
        padding: 6px 10px;
        border-radius: 6px;
        background: Canvas;
        color: CanvasText;
        box-shadow: 0 2px 8px #0002;
        font-size: 12px;
        pointer-events: none;
      }
      header[data-ready="true"] #status {
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        padding: 0;
      }
      #stage {
        flex: 1;
        min-height: 0;
        overflow: hidden;
        position: relative;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        touch-action: none;
        background: #8881;
      }
      canvas {
        display: block;
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        object-fit: contain;
        touch-action: none;
        outline: none;
        background: white;
      }
      #stage[data-ready="false"] canvas {
        opacity: 0.65;
      }
      #keyboard-panel {
        position: absolute;
        bottom: 12px;
        left: 12px;
        right: 12px;
        border: 1px solid #8887;
        border-radius: 10px;
        padding: 8px;
        background: Canvas;
        box-shadow: 0 4px 20px #0002;
      }
      #keyboard-panel[hidden] {
        display: none;
      }
      #keyboard-input {
        display: block;
        width: 100%;
        height: 40px;
        resize: none;
        border: 1px solid #8887;
        border-radius: 6px;
        padding: 8px;
        font-size: 16px;
        background: Canvas;
        color: CanvasText;
      }
      #keyboard-panel p {
        margin: 0 0 6px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 12px;
      }
      dialog {
        border: 1px solid #8885;
        border-radius: 12px;
        max-width: 340px;
      }
      dialog p {
        line-height: 1.5;
      }
    </style>
  </head>
  <body>
    <header <%= showControls ? '' : 'hidden' %>>
      <button id="back" class="icon-button" aria-label="Back" title="Back">‹</button>
      <button id="forward" class="icon-button" aria-label="Forward" title="Forward">›</button>
      <input id="url" aria-label="Browser address" autocomplete="off" spellcheck="false" readonly />
      <button id="keyboard" class="icon-button" type="button" aria-label="Keyboard" title="Keyboard" disabled>⌨️</button>
      <div class="viewport-control" title="Page layout">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 3H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h6v2H7v2h10v-2h-3v-2h6a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2zm0 14H4V5h16v12z"/></svg>
        <select id="viewport-mode" aria-label="Page layout" disabled>
          <option value="agent">Agent View</option>
          <option value="auto">Auto</option>
          <option value="mobile">Mobile</option>
          <option value="desktop">Desktop</option>
        </select>
      </div>
      <button id="menu-toggle" class="icon-button" type="button" aria-label="Browser options" title="Browser options" aria-expanded="false" aria-controls="browser-menu">⋯</button>
      <div id="browser-menu" hidden>
        <select id="tabs" aria-label="Browser tab" <%= singlePageMode ? 'hidden' : '' %>></select>
        <button id="close-tab" aria-label="Close tab" <%= singlePageMode ? 'hidden' : '' %>>Close tab</button>
        <button id="refresh" aria-label="Reload">Reload</button>
        <button id="control" type="button" disabled>Take control</button>
        <button id="reconnect" type="button" hidden>Reconnect</button>
      </div>
      <span id="status" role="status" aria-live="polite">Connecting…</span>
    </header>
    <main id="stage" data-ready="false">
      <canvas tabindex="0" aria-label="Live browser page"></canvas>
      <div id="keyboard-panel" hidden>
        <p>
          Type into the selected browser field.
          <button id="keyboard-close" class="icon-button" type="button" aria-label="Hide keyboard" title="Hide keyboard">×</button>
        </p>
        <textarea
          id="keyboard-input"
          aria-label="Browser keyboard"
          autocapitalize="off"
          autocomplete="off"
          autocorrect="off"
          spellcheck="false"
          inputmode="text"
        ></textarea>
      </div>
    </main>
    <dialog id="viewport-confirm">
      <p>Changing the page’s mobile emulation reloads it. Unsaved page input may be lost.</p>
      <button id="viewport-cancel">Cancel</button> <button id="viewport-reload">Reload page</button>
    </dialog>
    <script>
      (() => {
        "use strict";
        const VERSION = 1;
        const singlePageMode = <%- JSON.stringify(singlePageMode) %>;
        const interactive = <%- JSON.stringify(interactive) %>;
        const suppliedUrl = new URL(<%- JSON.stringify(wsUrl) %>, location.href);
        suppliedUrl.host = location.host;
        suppliedUrl.protocol = location.protocol === "https:" ? "wss:" : "ws:";
        const capability =
          /^\/s\/([^/]+)$/.exec(location.pathname)?.[1] ||
          new URLSearchParams(location.search).get("cap");
        if (capability) suppliedUrl.searchParams.set("cap", capability);
        const $ = (id) => document.getElementById(id);
        const canvas = document.querySelector("canvas");
        const context = canvas.getContext("2d");
        const stage = $("stage");
        const controlButton = $("control");
        const status = $("status");
        const layout = $("viewport-mode");
        const menu = $("browser-menu");
        function closeMenu() {
          menu.hidden = true;
          $("menu-toggle").setAttribute("aria-expanded", "false");
        }
        $("menu-toggle").addEventListener("click", () => {
          menu.hidden = !menu.hidden;
          $("menu-toggle").setAttribute("aria-expanded", String(!menu.hidden));
        });
        document.addEventListener("pointerdown", (event) => {
          if (!menu.contains(event.target) && !$("menu-toggle").contains(event.target))
            closeMenu();
        });
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && !menu.hidden) {
            closeMenu();
            $("menu-toggle").focus();
          }
        });
        menu.addEventListener("click", (event) => {
          if (event.target.closest("button")) closeMenu();
        });
        const keyboard = $("keyboard-input");
        const panel = $("keyboard-panel");
        let socket,
          connection = 0,
          reconnectTimer,
          resizeTimer;
        let retries = 0,
          expired = false,
          suspended = false,
          supported = false;
        let desiredControl = interactive;
        let controlling = false,
          ready = false,
          acquiring = false;
        let generation = 0,
          viewportGeneration = 0,
          sequence = 0,
          pageId = "";
        let serverWidth = 0,
          serverHeight = 0,
          mode = "agent",
          pendingMode;
        // Detect this viewer once when it opens. Server state and reconnects must
        // not overwrite the viewer's initial device choice or a manual selection.
        const mobileDevice =
          /Mobi|Android|iPhone|iPad|iPod/i.test(navigator.userAgent) ||
          navigator.userAgentData?.mobile === true ||
          (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);
        let openingLayout = window.ReactNativeWebView
          ? undefined
          : mobileDevice ? "mobile" : "agent";
        let metadata,
          paintedFrame = 0,
          sentFrame = 0,
          expiresAt = Infinity;
        let gesture,
          pendingMove,
          moveTimer,
          composing = false,
          keyboardText = "",
          keyboardCaret = 0;
        const graphemes = new Intl.Segmenter(undefined, { granularity: "grapheme" });
        const characters = (value) =>
          Array.from(graphemes.segment(value), (part) => part.segment);
        let discoverySocket,
          discoveryTimer,
          discoveryRetries = 0,
          selectedPage = "";
        let terminalMessage = "";
        let clipboardRequest = 0;
        const clipboardRequests = new Set();
        const parentOrigin = document.referrer
          ? new URL(document.referrer).origin
          : location.origin;
        const clipboardBridge =
          interactive &&
          window.parent !== window &&
          new URLSearchParams(location.search).get("clipboardBridge") === "true";
        const tellParent = (message) => {
          if (window.parent !== window) window.parent.postMessage(message, parentOrigin);
        };

        <%- include("mobile-session-input") %>
        <%- include("viewer-gestures") %>
        function setReady(value, message) {
          ready = value;
          stage.dataset.ready = String(value);
          document.querySelector("header").dataset.ready = String(value);
          $("keyboard").disabled = !value;
          layout.disabled = !controlling;
          for (const name of ["back", "forward", "refresh", "close-tab"])
            $(name).disabled = !value;
          $("url").readOnly = !value;
          if (message) status.textContent = message;
          mobileInput?.update();
        }
        function send(message) {
          if (!socket || socket.readyState !== WebSocket.OPEN) return false;
          socket.send(JSON.stringify({ version: VERSION, generation, ...message }));
          return true;
        }
        function action(message) {
          if (!ready) return false;
          return send({ pageId, viewportGeneration, sequence: ++sequence, ...message });
        }
        function clearLocalInput() {
          gesture = undefined;
          cancelLocalGesture();
          pendingMove = undefined;
          clearTimeout(moveTimer);
          moveTimer = undefined;
          composing = false;
          clearKeyboard();
          clipboardRequests.clear();
          mobileInput?.invalidate();
        }
        function cancelInput() {
          if (controlling) send({ type: "cancelInput" });
          clearLocalInput();
        }
        function control(actionName) {
          return send({ type: "control", action: actionName });
        }
        function takeControl() {
          if (!supported || acquiring || controlling || !interactive) return;
          desiredControl = true;
          acquiring = true;
          controlButton.disabled = true;
          status.textContent = "Connecting control…";
          control("acquire");
        }
        function requestViewport(nextMode = mode, reload = false) {
          if (nextMode !== mode) resetLocalView();
          if (!controlling) return;
          cancelInput();
          setReady(false, "Waiting for a fresh frame…");
          send({
            type: "viewport",
            mode: nextMode,
            width: Math.round(stage.clientWidth),
            height: Math.max(160, Math.round(mobileInput?.viewportHeight(nextMode) ?? stage.clientHeight)),
            reload,
          });
        }
        function scheduleReconnect(immediate = false) {
          clearTimeout(reconnectTimer);
          if (
            suspended ||
            expired ||
            Date.now() >= expiresAt ||
            (socket && socket.readyState <= WebSocket.OPEN)
          )
            return;
          if (!navigator.onLine) {
            setReady(false, "Offline — waiting for a connection.");
            return;
          }
          if (retries >= 8 && !immediate) {
            $("reconnect").hidden = false;
            setReady(false, "Connection lost. Reconnect to continue.");
            return;
          }
          setReady(false, "Reconnecting…");
          reconnectTimer = setTimeout(
            connect,
            immediate ? 0 : Math.min(250 * 2 ** retries++, 5000),
          );
        }
        function connect() {
          if (
            expired ||
            suspended ||
            Date.now() >= expiresAt ||
            (socket && socket.readyState <= WebSocket.OPEN)
          )
            return;
          clearTimeout(reconnectTimer);
          const epoch = ++connection;
          supported = false;
          acquiring = false;
          controlling = false;
          setReady(false, retries ? "Reconnecting…" : "Connecting…");
          clearLocalInput();
          paintedFrame = sentFrame = sequence = 0;
          metadata = undefined;
          const pageUrl = new URL(suppliedUrl);
          if (!singlePageMode) {
            if (!selectedPage) return;
            pageUrl.searchParams.delete("pageIndex");
            pageUrl.searchParams.set("pageId", selectedPage);
          }
          socket = new WebSocket(pageUrl);
          const ws = socket;
          ws.onopen = () => {
            if (epoch === connection) send({ type: "hello" });
          };
          ws.onmessage = (event) => {
            if (epoch !== connection) return;
            let data;
            try {
              data = JSON.parse(event.data);
            } catch {
              return;
            }
            if (data.type === "hello") {
              if (data.version !== VERSION) {
                expired = true;
                terminalMessage = "This viewer needs a matching browser update.";
                setReady(false, terminalMessage);
                ws.close();
                return;
              }
              supported = true;
              pageId = data.pageId;
              expiresAt = data.expiresAt;
              $("reconnect").hidden = true;
              return;
            }
            if (data.type === "controlState") {
              const gained =
                data.controlling && (!controlling || generation !== data.generation);
              if (
                generation !== data.generation ||
                controlling !== data.controlling ||
                viewportGeneration !== data.viewportGeneration
              ) {
                clearLocalInput();
                setReady(false);
              }
              generation = data.generation;
              viewportGeneration = data.viewportGeneration;
              controlling = data.controlling;
              acquiring = acquiring && !controlling && data.available;
              controlButton.disabled =
                !interactive || !supported || acquiring || (!controlling && !data.available);
              controlButton.textContent = controlling ? "Hand back" : "Take control";
              if (gained) {
                requestViewport(openingLayout ?? mode, openingLayout !== undefined);
                openingLayout = undefined;
              }
              else if (!controlling) {
                setReady(
                  false,
                  acquiring
                    ? "Connecting control…"
                    : data.available
                    ? "Watching the browser."
                    : "Another viewer has control.",
                );
                if (desiredControl && data.available && supported) takeControl();
              }
              return;
            }
            if (data.type === "viewportState") {
              mode = data.mode;
              serverWidth = data.width;
              serverHeight = data.height;
              viewportGeneration = data.viewportGeneration;
              layout.value = mode;
              mobileInput?.update();
              return;
            }
            if (data.type === "viewportReloadRequired") {
              pendingMode = data.mode;
              if (mobileInput) { mobileInput.reloadRequired(data.mode); return; }
              if (!$("viewport-confirm").open) $("viewport-confirm").showModal();
              return;
            }
            if (data.type === "viewportError") {
              setReady(false, "Could not change the page layout.");
              return;
            }
            if (data.type === "inputReady") {
              if (
                controlling &&
                data.generation === generation &&
                data.viewportGeneration === viewportGeneration
              ) {
                retries = 0;
                setReady(true, "You have control. Hand back when finished.");
              }
              return;
            }
            if (data.type === "inputError") {
              if (
                data.code === "session_expired" ||
                data.code === "unsupported_input_version"
              ) {
                expired = true;
                terminalMessage =
                  data.code === "session_expired"
                    ? "This browser session or viewer link has expired. Open a fresh handoff."
                    : "This viewer needs a matching browser update.";
                setReady(false, terminalMessage);
                ws.close();
              } else if (data.code === "another_viewer_controlling") {
                acquiring = false;
                desiredControl = false;
                setReady(false, "Another viewer has control.");
              } else if (data.code !== "stale_frame" && data.code !== "waiting_for_frame") {
                cancelInput();
                setReady(false, "Input paused. Reconnect to continue.");
                $("reconnect").hidden = false;
              }
              return;
            }
            if (data.type === "targetClosed") {
              expired = singlePageMode;
              terminalMessage = "This browser page is closed.";
              setReady(false, terminalMessage);
              ws.close();
              return;
            }
            if (data.type === "selectedTextResponse") {
              if (clipboardBridge && ready && data.text)
                tellParent({
                  type: "requestClipboardWrite",
                  requestId: ++clipboardRequest,
                  text: data.text,
                });
              return;
            }
            if (!data.data || !data.metadata) return;
            const frameConnection = connection;
            const image = new Image();
            image.onload = () => {
              if (
                frameConnection !== connection ||
                data.frameId <= paintedFrame ||
                (controlling &&
                  (data.generation !== generation ||
                    data.viewportGeneration !== viewportGeneration))
              )
                return;
              paintedFrame = data.frameId;
              canvas.width = image.naturalWidth;
              canvas.height = image.naturalHeight;
              updateCanvasSize();
              context.drawImage(image, 0, 0);
              metadata = data.metadata;
              if (document.activeElement !== $("url")) $("url").value = data.url || "";
              tellParent({ type: "navigation", url: data.url, favicon: data.favicon });
              if (
                controlling &&
                (mode === "agent" || (metadata.deviceWidth === serverWidth &&
                metadata.deviceHeight === serverHeight)) &&
                sentFrame !== data.frameId
              ) {
                sentFrame = data.frameId;
                send({ type: "frameReady", frameId: data.frameId });
              } else if (!controlling && supported) retries = 0;
            };
            image.src = "data:image/jpeg;base64," + data.data;
          };
          ws.onclose = (event) => {
            if (epoch !== connection) return;
            socket = undefined;
            clearLocalInput();
            controlling = false;
            acquiring = false;
            controlButton.disabled = true;
            if ((event.code === 4001 && singlePageMode) || Date.now() >= expiresAt)
              expired = true;
            if (expired)
              setReady(
                false,
                terminalMessage ||
                  "This browser session or viewer link has expired. Open a fresh handoff.",
              );
            else scheduleReconnect();
          };
          ws.onerror = () => {
            if (epoch === connection) setReady(false, "Connection interrupted…");
          };
        }

        function selectPage(id) {
          if (!id || selectedPage === id) return;
          cancelInput();
          if (controlling) control("release");
          ++connection;
          socket?.close();
          socket = undefined;
          selectedPage = id;
          $("tabs").value = id;
          expired = false;
          terminalMessage = "";
          retries = 0;
          connect();
        }
        function discoverTabs() {
          clearTimeout(discoveryTimer);
          if (
            singlePageMode ||
            suspended ||
            expired ||
            !navigator.onLine ||
            discoverySocket?.readyState <= WebSocket.OPEN
          )
            return;
          const url = new URL(suppliedUrl);
          url.searchParams.delete("pageId");
          url.searchParams.delete("pageIndex");
          url.searchParams.set("tabInfo", "true");
          const ws = (discoverySocket = new WebSocket(url));
          ws.onmessage = (event) => {
            if (ws !== discoverySocket) return;
            let data;
            try {
              data = JSON.parse(event.data);
            } catch {
              return;
            }
            if (data.type === "inputError" && data.code === "session_expired") {
              expired = true;
              setReady(
                false,
                "This browser session or viewer link has expired. Open a fresh handoff.",
              );
              return;
            }
            if (data.type !== "tabList" || !Array.isArray(data.tabs)) return;
            discoveryRetries = 0;
            $("tabs").replaceChildren(
              ...data.tabs.map((tab) => {
                const option = document.createElement("option");
                option.value = tab.id;
                option.textContent = tab.title || tab.url || "New tab";
                return option;
              }),
            );
            if (data.tabs.some((tab) => tab.id === selectedPage))
              $("tabs").value = selectedPage;
            else if (data.tabs.length) selectPage(data.firstTabId || data.tabs[0].id);
            else setReady(false, "No browser tabs are open.");
          };
          ws.onclose = (event) => {
            if (ws !== discoverySocket) return;
            discoverySocket = undefined;
            if (event.code === 4001) expired = true;
            if (!expired && !suspended && discoveryRetries < 8)
              discoveryTimer = setTimeout(
                discoverTabs,
                Math.min(250 * 2 ** discoveryRetries++, 5000),
              );
            else if (!suspended && !expired) {
              $("reconnect").hidden = false;
              setReady(false, "Tab connection lost. Reconnect to continue.");
            }
          };
        }
        $("tabs").addEventListener("change", () => selectPage($("tabs").value));
        $("close-tab").addEventListener("click", () => action({ type: "closeTab" }));

        controlButton.addEventListener("click", () => {
          if (controlling) {
            desiredControl = false;
            cancelInput();
            control("release");
            setReady(false, "Handing the browser back…");
            panel.hidden = true;
            keyboard.blur();
          } else takeControl();
        });
        $("reconnect").addEventListener("click", () => {
          expired = false;
          retries = discoveryRetries = 0;
          discoverTabs();
          if (socket) {
            cancelInput();
            socket.close();
          } else scheduleReconnect(true);
        });
        layout.addEventListener("change", () => requestViewport(layout.value));
        $("viewport-cancel").addEventListener("click", () => {
          $("viewport-confirm").close();
          pendingMode = undefined;
          requestViewport(mode);
        });
        $("viewport-reload").addEventListener("click", () => {
          $("viewport-confirm").close();
          requestViewport(pendingMode, true);
          pendingMode = undefined;
        });

        function coordinates(event) {
          if (!metadata) return null;
          const rect = canvas.getBoundingClientRect();
          if (!rect.width || !rect.height) return null;
          const scale = metadata.pageScaleFactor || 1;
          return {
            x: Math.max(
              0,
              Math.min(
                metadata.deviceWidth / scale,
                ((event.clientX - rect.left) * metadata.deviceWidth) / rect.width / scale,
              ),
            ),
            y: Math.max(
              0,
              Math.min(
                (metadata.deviceHeight - metadata.offsetTop) / scale,
                (((event.clientY - rect.top) * metadata.deviceHeight) / rect.height -
                  metadata.offsetTop) /
                  scale,
              ),
            ),
          };
        }
        const modifiers = (event) =>
          (event.altKey ? 1 : 0) |
          (event.ctrlKey ? 2 : 0) |
          (event.metaKey ? 4 : 0) |
          (event.shiftKey ? 8 : 0);
        const mouseButton = (button) =>
          ["left", "middle", "right", "back", "forward"][button] || "none";
        function mouse(type, point, button = "none", event = {}) {
          action({
            type: "mouseEvent",
            event: {
              type,
              ...point,
              button,
              modifiers: modifiers(event),
              clickCount: Math.min(3, event.detail || 1),
              ...(type === "mouseWheel"
                ? { deltaX: event.deltaX, deltaY: event.deltaY }
                : {}),
            },
          });
        }
        function move(point) {
          if (!gesture || !ready) return;
          if (gesture.kind === "drag") mouse("mouseMoved", point);
          else {
            if (Math.hypot(point.x - gesture.start.x, point.y - gesture.start.y) > 6)
              gesture.moved = true;
            if (gesture.moved)
              mouse("mouseWheel", point, "none", {
                deltaX: gesture.point.x - point.x,
                deltaY: gesture.point.y - point.y,
              });
          }
          gesture.point = point;
        }
        function flushMove() {
          clearTimeout(moveTimer);
          moveTimer = undefined;
          if (pendingMove) {
            const point = pendingMove;
            pendingMove = undefined;
            move(point);
          }
        }
        canvas.addEventListener("pointerdown", (event) => {
          if (!ready || event.pointerType !== "mouse" || !event.isPrimary || gesture) return;
          event.preventDefault();
          canvas.focus({ preventScroll: true });
          panel.hidden = true;
          const point = coordinates(event);
          if (!point) return;
          canvas.setPointerCapture(event.pointerId);
          const kind = event.pointerType === "mouse" ? "drag" : "scroll";
          gesture = {
            id: event.pointerId,
            kind,
            point,
            start: point,
            button: event.pointerType === "mouse" ? mouseButton(event.button) : "left",
            moved: false,
          };
          if (kind === "drag") mouse("mousePressed", point, gesture.button, event);
        });
        canvas.addEventListener("pointermove", (event) => {
          if (!ready || event.pointerType !== "mouse") return;
          if (!gesture) {
            if (event.pointerType === "mouse") {
              const point = coordinates(event);
              if (point) mouse("mouseMoved", point);
            }
            return;
          }
          if (event.pointerId !== gesture.id) return;
          event.preventDefault();
          pendingMove = coordinates(event);
          if (!moveTimer)
            moveTimer = setTimeout(() => {
              moveTimer = undefined;
              flushMove();
            }, 16);
        });
        canvas.addEventListener("pointerup", (event) => {
          if (!gesture || event.pointerId !== gesture.id) return;
          event.preventDefault();
          flushMove();
          const point = coordinates(event) || gesture.point;
          if (point.x !== gesture.point.x || point.y !== gesture.point.y) move(point);
          if (gesture.kind === "drag") mouse("mouseReleased", point, gesture.button, event);
          else if (!gesture.moved) {
            mouse("mousePressed", point, "left");
            mouse("mouseReleased", point, "left");
          }
          gesture = undefined;
          moveTimer = undefined;
          canvas.releasePointerCapture(event.pointerId);
        });
        for (const eventName of ["pointercancel", "lostpointercapture"])
          canvas.addEventListener(eventName, (event) => {
            if (gesture?.id === event.pointerId) cancelInput();
          });
        canvas.addEventListener("contextmenu", (event) => event.preventDefault());
        canvas.addEventListener(
          "wheel",
          (event) => {
            if (!ready || gesture) return;
            event.preventDefault();
            const point = coordinates(event);
            if (point)
              mouse("mouseWheel", point, "none", {
                deltaX: Math.max(-10000, Math.min(10000, event.deltaX)),
                deltaY: Math.max(-10000, Math.min(10000, event.deltaY)),
              });
          },
          { passive: false },
        );

        function key(type, key, code, keyCode, mods = 0) {
          action({ type: "keyEvent", event: { type, key, code, keyCode, modifiers: mods } });
        }
        function press(keyName, code, keyCode, mods = 0) {
          key("keyDown", keyName, code, keyCode, mods);
          key("keyUp", keyName, code, keyCode, mods);
        }
        function text(value) {
          if (value) action({ type: "insertText", text: value });
        }
        function clearKeyboard() {
          keyboard.value = "";
          keyboardText = "";
          keyboardCaret = 0;
        }
        function syncKeyboard() {
          if (!ready || composing || keyboard.value === keyboardText) return;
          const before = characters(keyboardText);
          const after = characters(keyboard.value);
          let start = 0;
          while (
            start < before.length &&
            start < after.length &&
            before[start] === after[start]
          )
            start++;
          let end = before.length;
          let nextEnd = after.length;
          while (end > start && nextEnd > start && before[end - 1] === after[nextEnd - 1]) {
            end--;
            nextEnd--;
          }
          // The local draft starts at the remote field's caret when the keyboard opens.
          const direction = end < keyboardCaret ? "ArrowLeft" : "ArrowRight";
          for (let i = 0; i < Math.abs(end - keyboardCaret); i++)
            press(direction, direction, direction === "ArrowLeft" ? 37 : 39);
          for (let i = start; i < end; i++) press("ArrowLeft", "ArrowLeft", 37, 8);
          const inserted = after.slice(start, nextEnd).join("");
          if (inserted) text(inserted);
          else if (end > start) press("Backspace", "Backspace", 8);
          keyboardText = keyboard.value;
          keyboardCaret = nextEnd;
        }
        $("keyboard").addEventListener("click", () => {
          if (!ready) return;
          if (panel.hidden) clearKeyboard();
          panel.hidden = false;
          keyboard.focus();
        });
        $("keyboard-close").addEventListener("click", () => {
          cancelInput();
          panel.hidden = true;
          keyboard.blur();
        });
        keyboard.addEventListener("compositionstart", () => {
          composing = true;
        });
        keyboard.addEventListener("compositionend", () => {
          composing = false;
          syncKeyboard();
        });
        keyboard.addEventListener("beforeinput", (event) => {
          if (!ready) {
            event.preventDefault();
            return;
          }
          if (composing || event.isComposing) return;
          if (
            event.inputType === "insertLineBreak" ||
            event.inputType === "insertParagraph"
          ) {
            event.preventDefault();
            press("Enter", "Enter", 13);
            clearKeyboard();
          } else if (!keyboard.value && event.inputType.startsWith("delete")) {
            const forward = event.inputType.includes("Forward");
            press(
              forward ? "Delete" : "Backspace",
              forward ? "Delete" : "Backspace",
              forward ? 46 : 8,
            );
          }
        });
        keyboard.addEventListener("input", (event) => {
          if (!event.isComposing) syncKeyboard();
        });
        document.addEventListener("paste", (event) => {
          if (
            !ready ||
            (event.target !== keyboard &&
              event.target !== canvas &&
              event.target !== document.body)
          )
            return;
          event.preventDefault();
          const pasted = event.clipboardData?.getData("text/plain") || "";
          if (event.target === keyboard) {
            keyboard.setRangeText(
              pasted,
              keyboard.selectionStart,
              keyboard.selectionEnd,
              "end",
            );
            syncKeyboard();
          } else text(pasted);
        });
        if (clipboardBridge) {
          tellParent({ type: "clipboardBridgeReady" });
          window.addEventListener("message", (event) => {
            if (event.source !== window.parent || event.origin !== parentOrigin || !ready)
              return;
            const data = event.data;
            if (data?.type === "triggerCopy") action({ type: "getSelectedText" });
            else if (data?.type === "triggerPaste" && typeof data.text === "string")
              text(data.text);
            else if (
              data?.type === "clipboardReadResponse" &&
              clipboardRequests.delete(data.requestId) &&
              typeof data.text === "string"
            )
              text(data.text);
          });
          document.addEventListener("keydown", (event) => {
            if (
              !ready ||
              (event.target !== canvas && event.target !== document.body) ||
              (!event.ctrlKey && !event.metaKey)
            )
              return;
            const shortcut = event.key.toLowerCase();
            if (shortcut !== "c" && shortcut !== "v") return;
            event.preventDefault();
            if (shortcut === "c") action({ type: "getSelectedText" });
            else {
              const requestId = ++clipboardRequest;
              clipboardRequests.add(requestId);
              tellParent({ type: "requestClipboardRead", requestId });
            }
          });
        }
        document.addEventListener("keydown", (event) => {
          if (!ready || (event.target !== canvas && event.target !== document.body)) return;
          if (
            (event.ctrlKey || event.metaKey) &&
            ["v", "c", "x"].includes(event.key.toLowerCase())
          )
            return;
          event.preventDefault();
          key("keyDown", event.key, event.code, event.keyCode, modifiers(event));
        });
        document.addEventListener("keyup", (event) => {
          if (!ready || (event.target !== canvas && event.target !== document.body)) return;
          if (
            (event.ctrlKey || event.metaKey) &&
            ["v", "c", "x"].includes(event.key.toLowerCase())
          )
            return;
          event.preventDefault();
          key("keyUp", event.key, event.code, event.keyCode, modifiers(event));
        });
        for (const name of ["back", "forward", "refresh"])
          $(name).addEventListener("click", () =>
            action({ type: "navigation", event: { action: name } }),
          );
        $("url").addEventListener("keydown", (event) => {
          if (event.key !== "Enter" || !ready) return;
          event.preventDefault();
          let url = $("url").value.trim();
          if (!/^https?:\/\//i.test(url)) url = "https://" + url;
          action({ type: "navigation", event: { url } });
          canvas.focus();
        });
        window.addEventListener("blur", cancelInput);
        let viewerWidth = window.innerWidth;
        window.addEventListener("resize", () => {
          const widthChanged = viewerWidth !== window.innerWidth;
          viewerWidth = window.innerWidth;
          updateCanvasSize();
          if (!controlling) return;
          // Native keyboard animations change only the visible height. Neither
          // opening nor closing it should cancel a pinch or resize the session.
          if (mobileInput && (!widthChanged || mobileInput.keyboardOpen())) return;
          if (mode === "agent") { cancelInput(); return; }
          cancelInput();
          setReady(false, "Adjusting the page…");
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(() => requestViewport(), 150);
        });
        window.addEventListener("online", () => {
          discoverTabs();
          scheduleReconnect(true);
        });
        document.addEventListener("visibilitychange", () => {
          suspended = document.hidden;
          if (suspended) {
            cancelInput();
            if (controlling) control("pause");
            socket?.close();
            discoverySocket?.close();
          } else {
            discoverTabs();
            scheduleReconnect(true);
          }
        });
        window.addEventListener("pagehide", () => {
          suspended = true;
          cancelInput();
          if (controlling) control("pause");
          socket?.close();
          discoverySocket?.close();
        });
        window.addEventListener("pageshow", () => {
          suspended = false;
          discoverTabs();
          scheduleReconnect(true);
        });
        if (!interactive) {
          desiredControl = false;
          controlButton.hidden = true;
          $("keyboard").hidden = true;
        }
        if (singlePageMode) connect();
        else discoverTabs();
      })();
    </script>
  </body>
</html>
