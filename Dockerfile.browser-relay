FROM node:22-alpine

WORKDIR /app

COPY local-browser-relay/package.json local-browser-relay/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force

COPY local-browser-relay/broker.mjs local-browser-relay/connector.mjs ./

ENV NODE_ENV=production

USER 1000:1000

EXPOSE 8081

ENTRYPOINT ["node", "/app/broker.mjs"]
