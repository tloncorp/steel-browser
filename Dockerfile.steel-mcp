# Build the sibling Steel MCP checkout, then add the stdio-to-HTTP bridge that
# lets Urbit's remote MCP proxy connect to it.
FROM node:22-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
COPY tsconfig.json tsconfig.build.json ./
COPY src ./src
COPY scripts/clean-dist.mjs ./scripts/clean-dist.mjs

RUN npm ci --ignore-scripts
RUN npm run build
RUN npm prune --omit=dev

FROM node:22-alpine

RUN apk add --no-cache python3 \
 && python3 -m venv /opt/mcp-proxy \
 && /opt/mcp-proxy/bin/pip install --no-cache-dir mcp-proxy==0.11.0 mcp==1.26.0

WORKDIR /app

COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json

EXPOSE 8000

ENTRYPOINT ["/opt/mcp-proxy/bin/mcp-proxy"]
CMD ["--host", "0.0.0.0", "--port", "8000", "--stateless", "--pass-environment", "node", "dist/stdio.js"]
